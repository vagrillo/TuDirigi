# TuDirector — chiavi API e configurazione (override con prefisso TD_)
# OpenRouter (visione + regista LLM): https://openrouter.ai/keys
TD_OPENROUTER_API_KEY=
# fal.ai (STT whisper + generazione immagini): https://fal.ai/dashboard/keys
TD_FAL_KEY=

# Modelli (opzionali)
# TD_VISION_MODEL=google/gemini-2.5-flash
# TD_DIRECTOR_MODEL=anthropic/claude-sonnet-4.5
# TD_FAL_WHISPER_MODEL=fal-ai/whisper
# TD_FAL_IMAGE_MODEL=fal-ai/flux/schnell

# Pipeline (opzionali)
# TD_STT_LANGUAGE=it  (lingua del parlato)
# TD_FRAME_FPS=1.0
# TD_WINDOW_LEN=30.0
# TD_ASSETS_POLICY=auto
